# ==============================================================================
# ALVI — Environment Configuration Template
# Phase 11: Gemma 4 AI Insights & Explanation Engine
# ==============================================================================
# Copy this file to .env and provide your secret API keys:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit the .env file to Git!
# - Never expose your API keys in frontend code or client requests!
# - If GEMINI_API_KEY is not set, ALVI gracefully operates in deterministic
#   local mode with status "unavailable" (no crashes).
# ==============================================================================

# Google Gemini / Gemma 4 API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider Configuration
# Supported: "gemma" (default)
AI_PROVIDER=gemma

# Model Identifier
# Primary recommended: gemma-4-26b-a4b-it
# Alternative: gemma-4-31b-it
AI_MODEL=gemma-4-26b-a4b-it

# Server Port and Host Settings (Default: 8765)
PORT=8765
HOST=127.0.0.1


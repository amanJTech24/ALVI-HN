# ──────────────────────────────────────────────
# ALVI — .gitignore
# ──────────────────────────────────────────────

# ── Environment & Secrets ──────────────────────
.env
.env.*
!.env.example
.env.local
.env.production
*.key
*.pem
*.p12
*.pfx
*.secret
*.credentials
*.token
tokens/
secrets/
*.api_key
api_keys/

# ── Dependencies ───────────────────────────────
node_modules/
bower_components/
vendor/
package-lock.json
yarn.lock

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Audio & Personal Voice Recordings ──────────
*.wav
*.mp3
*.webm
*.ogg
*.m4a
*.flac
*.aac
recordings/
uploads/
audio_recordings/

# ── Machine Learning Models & Large Artifacts ──
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pkl
*.pickle
*.joblib
*.bin
*.model
*.weights
models/
model/
# Explicit whitelist for ALVI lightweight deployed model artifacts
!backend/ml/models/
!backend/ml/models/**

# ── Private Datasets ───────────────────────────
data/*
!data/processed/
!data/processed/**
datasets/
dataset/
*.parquet
*.arrow
data/dementianet/

# ── IDE / Editor ───────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── OS & Temporary Files ───────────────────────
*.tmp
*.temp
*.log
*.bak
*.cache

# ── Build Outputs ─────────────────────────────
*.min.js
*.min.css
*.map

# ── Phase 12: Hardware Companion ──────────────
hardware/alvi_pocket_companion/config.h
hardware_events.db
hardware_events.db.bak*
*.db
*.db-shm
*.db-wal

# NeuroPen uploaded files (may contain personal health data)
data/neuropen_uploads/

# Firmware backups
*.ino.bak
*.cpp.bak
*.h.bak
*.py.bak
*.original_dashboard_copy

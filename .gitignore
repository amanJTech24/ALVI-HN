# ──────────────────────────────────────────────
# ALVI — .gitignore
# ──────────────────────────────────────────────

# ── Environment & Secrets ──────────────────────
.env
.env.*
.env.local
.env.production
*.key
*.pem
*.p12
*.pfx
*.secret
*.credentials
*.token
tokens/
secrets/
*.api_key
api_keys/

# ── Dependencies ───────────────────────────────
node_modules/
bower_components/
vendor/
package-lock.json
yarn.lock

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Audio & Personal Voice Recordings ──────────
*.wav
*.mp3
*.webm
*.ogg
*.m4a
*.flac
*.aac
recordings/
uploads/
audio_recordings/

# ── Machine Learning Models & Large Artifacts ──
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pkl
*.pickle
*.joblib
*.bin
*.model
*.weights
models/
model/

# ── Private Datasets ───────────────────────────
data/
datasets/
dataset/
*.parquet
*.arrow

# ── IDE / Editor ───────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── OS & Temporary Files ───────────────────────
*.tmp
*.temp
*.log
*.bak
*.cache

# ── Build Outputs ─────────────────────────────
*.min.js
*.min.css
*.map
